# --- required: API auth token for the model -------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key is not scoped to a workspace (console -> Settings -> Workspaces)
ANTHROPIC_WORKSPACE_ID=

# --- optional: model tuning ------------------------------------------------
LLM_MODEL=claude-opus-5
LLM_EXTRACT_EFFORT=low
LLM_RESPOND_EFFORT=low
# The fixtures are dated early 2026; the demo clock is pinned so deadlines read as upcoming. Set empty to use the real date.
DEMO_TODAY=2026-03-02

# --- optional: real email delivery ------------------------------------------
# Preferred: Brevo HTTPS API (works where outbound SMTP is blocked, e.g. Render free tier).
BREVO_API_KEY=
# Alternative: SMTP (Gmail app password works locally).
# Leave blank and the agent captures the summary in an on-screen mock outbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=you@gmail.com
