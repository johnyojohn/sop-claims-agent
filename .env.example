# --- required: API auth token for the model -------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Required only if the key is not scoped to a workspace (Anthropic then rejects
# every call with "must include the anthropic-workspace-id header").
# Find it at console.anthropic.com -> Settings -> Workspaces; starts with wrkspc_
ANTHROPIC_WORKSPACE_ID=

# --- optional: model tuning ------------------------------------------------
LLM_MODEL=claude-opus-5
LLM_EXTRACT_EFFORT=low
LLM_RESPOND_EFFORT=low
# The fixtures are dated early 2026; the demo clock is pinned so deadlines read as upcoming. Set empty to use the real date.
DEMO_TODAY=2026-03-02

# --- optional: real email delivery ------------------------------------------
# Leave everything below blank and the summary is captured in the on-screen
# mock outbox. Fill in either block for real delivery.
# Preferred on hosts that block outbound SMTP (e.g. Render free tier): Brevo HTTPS API.
BREVO_API_KEY=
# SMTP (a Gmail address with an app password works): host smtp.gmail.com, port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- optional: hardening ------------------------------------------------------
# Bearer token required on every /api route when set.
APP_ACCESS_TOKEN=
# Per-IP messages per minute.
RATE_LIMIT_PER_MIN=30
